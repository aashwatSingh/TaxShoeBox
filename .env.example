# ============================================================
# TaxShoe — Environment Variables
# ============================================================
# Copy this file to .env and fill in your Supabase credentials.
# Find these at: https://app.supabase.com/project/<id>/settings/api
#
# IMPORTANT: Never commit your .env file to version control.
# The anon key is safe to use in the browser (RLS protects the data).
# Never expose your service_role key on the frontend.
# ============================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
